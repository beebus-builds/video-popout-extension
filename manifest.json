{
  "manifest_version": 3,
  "name": "Video Popout (Picture-in-Picture)",
  "version": "1.2.0",
  "description": "Pop any video into a floating always-on-top window. Picker with thumbnails, hover button, multi-popout, whole-tab capture, and pro controls.",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage", "tabCapture", "webNavigation", "sidePanel", "alarms", "downloads"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pop out video (Alt+P)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Pop out the playing video"
    },
    "popout-tab": {
      "description": "Pop out the entire tab in a floating window"
    }
  }
}
